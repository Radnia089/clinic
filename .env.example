# SQLite database (relative to project root)
DATABASE_URL="file:./.data/clinic.db"

# Public site URL (for SMS links)
NEXT_PUBLIC_APP_URL=https://tandisclinicyazd.ir

# Optional: force provider — mock | kavenegar | android
# SMS_PROVIDER=android

# Preferred: Android phone as SMS gateway (SMS Gateway app / sms-gate.app)
# Install the app, open Home tab, copy username & password.
# SMS_ANDROID_USERNAME=
# SMS_ANDROID_PASSWORD=
# SMS_ANDROID_BASE_URL=https://api.sms-gate.app
# SMS_ANDROID_DEVICE_ID=
# SMS_ANDROID_SIM_NUMBER=1

# Optional: Kavenegar SMS panel (used if Android gateway is not configured)
# KAVENEGAR_API_KEY=
# KAVENEGAR_SENDER=1000xxxx

# Optional: protect reminder cron
# REMINDER_CRON_SECRET=

# Web Push (patient inbox notifications) — generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:info@tandisclinicyazd.ir
