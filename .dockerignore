# Dependencies and build output are produced inside the image
node_modules
.next
out
build
coverage
src/generated/prisma
*.tsbuildinfo
next-env.d.ts

# Runtime data and secrets must never be baked into the image
.data
.env
.env.*
!.env.example
public/uploads/**
!public/uploads/**/.gitkeep
*.pem
*.db
*.db-journal
*.sqlite

# VCS, editors, tooling
.git
.gitignore
.github
.vscode
.idea
.cursor
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Container and deployment files
Dockerfile
.dockerignore
deploy
docs
*.md
!README.md
