# -----------------------------------------------------------------------------
# Image
# -----------------------------------------------------------------------------
APP_IMAGE=registry.hamdocker.ir/amintvk/tandis-clinic
# Tag pushed by GitHub Actions / docker/build-and-push.sh (usually prod).
APP_TAG=prod

# -----------------------------------------------------------------------------
# Networking / resources
# -----------------------------------------------------------------------------
# Use PUBLISH_ADDR=127.0.0.1 and another port if a host-level reverse proxy
# (nginx, Caddy, Traefik) terminates TLS in front of this stack.
PUBLISH_ADDR=0.0.0.0
PUBLISH_PORT=80
APP_CPUS=1.0
APP_MEMORY=1g
TZ=Asia/Tehran

# -----------------------------------------------------------------------------
# Application runtime
# -----------------------------------------------------------------------------
# Apply Prisma migrations automatically on container start.
RUN_MIGRATIONS=true
# Start the SMS reminder scheduler right after boot.
REMINDER_SCHEDULER_AUTOSTART=true
# Optional shared secret for external cron calls to POST /api/reminders.
REMINDER_CRON_SECRET=

# -----------------------------------------------------------------------------
# SMS providers (priority: Android gateway -> Kavenegar -> mock)
# -----------------------------------------------------------------------------
# SMS_PROVIDER=android

# SMS_ANDROID_USERNAME=
# SMS_ANDROID_PASSWORD=
# SMS_ANDROID_BASE_URL=https://api.sms-gate.app
# SMS_ANDROID_DEVICE_ID=
# SMS_ANDROID_SIM_NUMBER=1

# KAVENEGAR_API_KEY=
# KAVENEGAR_SENDER=
